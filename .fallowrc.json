{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": ["obsidian", "tslib"],
  "usedClassMembers": [
    {
      "extends": "FuzzySuggestModal",
      "members": ["onOpen", "getItems", "getItemText", "renderSuggestion", "onChooseItem"]
    },
    {
      "extends": "AbstractInputSuggest",
      "members": ["getSuggestions", "renderSuggestion", "selectSuggestion"]
    },
    {
      "extends": "PluginSettingTab",
      "members": ["icon"]
    }
  ],
  "health": {
    "thresholdOverrides": [
      {
        "files": ["src/ui/**", "src/commands/**", "src/base/sequenceEdit.ts"],
        "maxCrap": 80,
        "reason": "Obsidian DOM/workspace glue: no test harness outside the app, so static coverage is 0 and CRAP is complexity squared; complexity limits still apply"
      }
    ]
  }
}
